    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst projectsMap = {};\n\nfor (const item of items) {\n  const t = item.json;\n  const deadline = new Date(t.deadline);\n  const daysLate = t.status !== 'مكتملة' ? Math.floor((now - deadline) / (1000*60*60*24)) : 0;\n\n  if (!projectsMap[t.projectName]) {\n    projectsMap[t.projectName] = { projectName: t.projectName, totalTasks: 0, completedTasks: 0, lateTasks: 0, maxDaysLate: 0, lateTasksList: [] };\n  }\n  const p = projectsMap[t.projectName];\n  p.totalTasks++;\n  if (t.status === 'مكتملة') p.completedTasks++;\n  if (daysLate > 0) {\n    p.lateTasks++;\n    p.maxDaysLate = Math.max(p.maxDaysLate, daysLate);\n    p.lateTasksList.push(t.taskName + ' (متأخرة ' + daysLate + ' يوم)');\n  }\n}\n\nreturn Object.values(projectsMap).map(p => ({ json: {\n  ...p,\n  completionRate: ((p.completedTasks / p.totalTasks) * 100).toFixed(0),\n  lateTasksList: p.lateTasksList.join(', ')\n} }));"
      },
